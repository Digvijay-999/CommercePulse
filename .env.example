# Copy to .env if you want to change a setting. Never commit .env.
# Every value below is already the default, so .env is optional.

# Which data source to build: synthetic (default) or ga4. Sources never mix:
# raw files -> data/raw/<source>/, warehouse -> data/warehouse/<source>.duckdb
COMMERCEPULSE_SOURCE=synthetic

# Where dbt finds dbt_project.yml and profiles.yml (relative to the repo root).
# Lets you type the short form:  uv run --env-file .env dbt build
DBT_PROJECT_DIR=data_pipeline/dbt
DBT_PROFILES_DIR=data_pipeline/dbt
